# Copy this file to .env and replace every placeholder with environment-specific values.
# Never commit .env or paste production credentials into source files.

# MongoDB
MONGO_URI=mongodb+srv://<username>:<password>@<cluster-host>/<database>?retryWrites=true&w=majority
MONGO_DB_NAME=student_expense_tracker

# Generate unique, high-entropy values for every environment.
JWT_SECRET=replace-with-a-long-random-secret
DJANGO_SECRET_KEY=replace-with-a-long-random-django-secret
JWT_ALGORITHM=HS256
JWT_EXP_MINUTES=60

# Development only. Set False in production and configure ALLOWED_HOSTS separately.
DJANGO_DEBUG=True
